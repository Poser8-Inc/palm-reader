{
  "expo": {
    "name": "Palm Reader",
    "slug": "palm-reader",
    "version": "1.0.6",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.templari.palmreader",
      "buildNumber": "31",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Palm Reader uses the camera to photograph the lines on your palm so we can identify and interpret the four major lines (Life, Head, Heart, Fate). For example, hold your dominant hand flat in front of the camera with your palm facing up.",
        "NSPhotoLibraryUsageDescription": "Palm Reader can analyze an existing palm photograph from your photo library. For example, choose a clear photo of your dominant hand's palm and Palm Reader will identify the major lines."
      }
    },
    "android": {
      "package": "app.templari.palmreader",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0B0F"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "targetSdkVersion": 35,
            "compileSdkVersion": 35
          }
        }
      ],
      "expo-secure-store"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0B0F"
    },
    "scheme": "palmreader",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8d6eeba4-df81-43ed-9118-901af731ddb2"
      }
    },
    "owner": "poser8"
  }
}
